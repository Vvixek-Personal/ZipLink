# APP_URL: The public base URL where ZipLink is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# STORAGE_DRIVER: "local" (default) or "gcs" (Google Cloud Storage + Firestore)
STORAGE_DRIVER=local

# Google Cloud Storage + Firestore configuration (required only when STORAGE_DRIVER=gcs)
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
FIRESTORE_COLLECTION=ziplink_shares

# Local storage directory (used when STORAGE_DRIVER=local)
ZIPLINK_DATA_DIR=./data

# Configurable extraction & upload limits
ZIPLINK_MAX_COMPRESSED_BYTES=52428800
ZIPLINK_MAX_EXTRACTED_BYTES=209715200
ZIPLINK_MAX_SINGLE_FILE_BYTES=26214400
ZIPLINK_MAX_ENTRY_COUNT=500
ZIPLINK_MAX_DIRECTORY_DEPTH=15
ZIPLINK_MAX_CONTEXT_MD_BYTES=524288
ZIPLINK_MAX_TEXT_PREVIEW_BYTES=524288
ZIPLINK_CLEANUP_INTERVAL_MS=60000
ZIPLINK_UPLOAD_RATE_LIMIT=20

# Temporary Website Preview settings
# ZIPLINK_PREVIEW_DIR defaults to os.tmpdir()/ziplink-previews when unset
ZIPLINK_PREVIEW_DIR=
ZIPLINK_PREVIEW_TTL_MS=7200000
# Optional dedicated preview origin (e.g. https://preview.example.com) for cross-origin iframe isolation
ZIPLINK_PREVIEW_ORIGIN=

