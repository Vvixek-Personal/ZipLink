# APP_URL: The public base URL where ZipLink is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# STORAGE_DRIVER: "local" (default) or "gcs" (Google Cloud Storage + Firestore)
STORAGE_DRIVER=local

# Google Cloud Storage + Firestore configuration (required only when STORAGE_DRIVER=gcs)
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
FIRESTORE_COLLECTION=ziplink_shares

# Local storage directory (used when STORAGE_DRIVER=local)
ZIPLINK_DATA_DIR=./data

# Configurable extraction & upload limits
ZIPLINK_MAX_COMPRESSED_BYTES=52428800
ZIPLINK_MAX_EXTRACTED_BYTES=209715200
ZIPLINK_MAX_ENTRY_COUNT=500
ZIPLINK_MAX_CONTEXT_MD_BYTES=524288
ZIPLINK_MAX_TEXT_PREVIEW_BYTES=524288
ZIPLINK_CLEANUP_INTERVAL_MS=60000
ZIPLINK_UPLOAD_RATE_LIMIT=20

# GitHub App OAuth configuration (all values stay strictly server-side)
# Required for real GitHub workspace & ZIP-to-GitHub features:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Optional GitHub App metadata / webhook signing / JWT credentials:
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# 32+ character server secret used to encrypt stored GitHub session tokens (AES-256-GCM)
ZIPLINK_SESSION_SECRET=

# Firebase Authentication (Google sign-in + server-side ID token verification):
# Client settings come from /firebase-applet-config.json. Set FIREBASE_PROJECT_ID only if overriding project ID on server:
FIREBASE_PROJECT_ID=

